#include <stdio.h>
#include <stdlib.h>
int n, a[30], total, min = 999999;
void fun(int i, int cnt, int sum)
{
    if (i == n)
    {
        if (cnt == n/2 || cnt == (n+1)/2)
        {
            int d = abs(total - 2*sum);
            if (d < min)
                min = d;
        }
        return;
    }
    fun(i+1, cnt, sum);
    fun(i+1, cnt+1, sum+a[i]);
}
int main()
{
    scanf("%d", &n);

    for (int i=0; i<n; i++)
    {
        scanf("%d", &a[i]);
        total += a[i];
    }
    fun(0, 0, 0);
    printf("%d", min);
    return 0;
}
