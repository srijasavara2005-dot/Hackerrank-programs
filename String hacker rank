#include <stdio.h>
#include <string.h>
char sub[100];
int ans = 0;
int palindrome(char s[], int len)
{
    int i = 0, j = len - 1;
    while (i < j)
    {
        if (s[i] != s[j])
            return 0;
        i++;
        j--;
    }
    return 1;
}
void solve(char str[], int n, int idx, int len)
{
    if (idx == n)
    {
        if (palindrome(sub, len) && len > ans)
            ans = len;
        return;
    }
    sub[len] = str[idx];
    solve(str, n, idx + 1, len + 1);
    solve(str, n, idx + 1, len);
}
int main()
{
    char str[100];
    scanf("%s", str);
    solve(str, strlen(str), 0, 0);
    printf("%d", ans);
    return 0;
}
