#include <stdio.h>
int main() {
    int n, i, j, k = 0, p, found = 0;
    char input[1000], word[100][100], pattern[100];
    scanf("%d", &n);
    scanf("%s", input);
    scanf("%s", pattern);
    p = 0;
    for (i = 0; input[i] != '\0'; i++) {
        if (input[i] == ',') {
            word[p][k] = '\0'; 
            p++;
            k = 0;
        } else {
            word[p][k] = input[i]; 
            k++;
        }
    }
    word[p][k] = '\0';
    for (i = 0; i < n; i++) {
        k = 0;
        for (j = 0; word[i][j] != '\0'; j++) {
            if (word[i][j] >= 'A' && word[i][j] <= 'Z') {
                
                if (word[i][j] == pattern[k])
                    k++;
                else
                    break;
            }
        }
        if (pattern[k] == '\0') {
            printf("%s\n", word[i]);
            found = 1;
        }
    }
    if (found == 0)
        printf("No match found");
    return 0;
}
