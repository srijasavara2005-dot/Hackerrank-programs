#include <stdio.h>
int main() {
    int n, i, a[100];
    int min = 0, max = 0, temp;
    scanf("%d", &n);
    for(i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    for(i = 1; i < n; i++) {
        if(a[i] < a[min])
            min = i;
        if(a[i] > a[max])
            max = i;
    }
    temp = a[min];
    a[min] = a[max];
    a[max] = temp;
    for(i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }
    return 0;
}
