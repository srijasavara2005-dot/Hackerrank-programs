#include <stdio.h>
int main() {
    int V, N;
    scanf("%d %d", &V, &N);
    int c[N], dp[V + 1];
    for (int i = 0; i < N; i++)
        scanf("%d", &c[i]);
    for (int i = 0; i <= V; i++)
        dp[i] = V + 1;
    dp[0] = 0;
    for (int i = 1; i <= V; i++) {
        for (int j = 0; j < N; j++) {
            if (c[j] <= i && dp[i - c[j]] + 1 < dp[i])
                dp[i] = dp[i - c[j]] + 1;
        }
    }
    if (dp[V] == V + 1)
        printf("-1\n");
    else
        printf("%d\n", dp[V]);
    return 0;
}
