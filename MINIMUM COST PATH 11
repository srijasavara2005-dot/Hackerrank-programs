#include <stdio.h>
int main() {
    int n, m;
    scanf("%d %d", &n, &m);
    int a[n][m], dp[n][m];
    for (int i = 0; i < n; i++)
        for (int j = 0; j < m; j++)
            scanf("%d", &a[i][j]);
    dp[0][0] = a[0][0];
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            if (i == 0 && j == 0)
                continue;
            int x = 999999999;
          if (i > 0)
                x = dp[i-1][j];
            if (j > 0 && dp[i][j-1] < x)
                x = dp[i][j-1];
            if (i > 0 && j > 0 && dp[i-1][j-1] < x)
                x = dp[i-1][j-1];
            dp[i][j] = a[i][j] + x;
        }
    }
    printf("%d", dp[n-1][m-1]);
    return 0;
}
