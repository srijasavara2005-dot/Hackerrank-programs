#include <stdio.h>
int main()
{
    int n, i, j;
    scanf("%d", &n);
    float a[n];
    for(i = 0; i < n; i++)
        scanf("%f", &a[i]);
    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            if(a[j] > a[j + 1])
            {
                float temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
    for(i = 0; i < n; i++)
    {
        if(a[i] == (int)a[i])
            printf("%.0f ", a[i]);
        else
            printf("%.2f ", a[i]);
    }
    return 0;
}
