#include <stdio.h>
int cycleLength(long long n)
{
    int count = 1;
    while (n != 1)
    {
        if (n % 2 == 0)
            n = n / 2;
        else
            n = 3 * n + 1;
        count++;
    }
    return count;
}
int main()
{
    int i, j;
    scanf("%d %d", &i, &j);
    int start = i;
    int end = j;
    if (start > end)
    {
        int temp = start;
        start = end;
        end = temp;
    }
    int maxCycle = 0;
    for (int n = start; n <= end; n++)
    {
        int len = cycleLength(n);

        if (len > maxCycle)
            maxCycle = len;
    }
    printf("%d %d %d\n", i, j, maxCycle);
    return 0;
}

