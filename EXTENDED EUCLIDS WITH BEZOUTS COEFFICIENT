#include <stdio.h>
long long egcd(long long a, long long b, long long *x, long long *y)
{
    if (b == 0)
    {
        *x = 1;
        *y = 0;
        return a;
    }
    long long x1, y1;
    long long d = egcd(b, a % b, &x1, &y1);
    *x = y1;
    *y = x1 - (a / b) * y1;
    return d;
}
int main()
{
    long long A, B, x, y;
    scanf("%lld %lld", &A, &B);
    long long D = egcd(A, B, &x, &y);
    printf("%lld %lld %lld", x, y, D);
    return 0;
}
