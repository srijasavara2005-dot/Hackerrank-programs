#include <stdio.h>
int main() {
    int n, m, a[500][500];
    int fresh = 0, time = 0, change;
    scanf("%d %d", &n, &m);
    for (int i = 0; i < n; i++)
        for (int j = 0; j < m; j++) {
            scanf("%d", &a[i][j]);
            if (a[i][j] == 1)
                fresh++;
        }
    while (fresh > 0) {
        change = 0;
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (a[i][j] == 2) {
                    if (i > 0 && a[i-1][j] == 1)
                        a[i-1][j] = 3;
                    if (i < n-1 && a[i+1][j] == 1)
                        a[i+1][j] = 3;
                    if (j > 0 && a[i][j-1] == 1)
                        a[i][j-1] = 3;
                    if (j < m-1 && a[i][j+1] == 1)
                        a[i][j+1] = 3;
                }
            }
        }
        for (int i = 0; i < n; i++)
            for (int j = 0; j < m; j++)
                if (a[i][j] == 3) {
                    a[i][j] = 2;
                    fresh--;
                    change = 1;
                }
        if (change == 0) {
            printf("-1");
            return 0;
        }
        time++;
    }
    printf("%d", time);
    return 0;
}
