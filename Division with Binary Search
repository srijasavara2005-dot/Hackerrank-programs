#include <stdio.h>
int main() {
    long long x, y;
    scanf("%lld %lld", &x, &y);
    if (y == 0) {
        printf("Division by zero");
        return 0;
    }
    int negative = 0;
    if ((x < 0 && y > 0) || (x > 0 && y < 0))
        negative = 1;
    if (x < 0)
        x = -x;
    if (y < 0)
        y = -y;
    long long low = 0, high = x, mid, ans = 0;
    while (low <= high) {
        mid = low + (high - low) / 2;

        if (mid * y == x) {
            ans = mid;
            break;
        } else if (mid * y < x) {
            ans = mid;
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    if (negative)
        ans = -ans;
    printf("%lld", ans);
    return 0;
}
